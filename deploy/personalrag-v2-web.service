[Unit]
Description=PersonalRAG v2 Web
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/personalrag-v2/app
ExecStart=/root/personalrag-v2/app/.venv/bin/python -m uvicorn web_app:create_app --factory --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
